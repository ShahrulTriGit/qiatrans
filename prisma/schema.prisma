generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(cuid())
  nama          String
  email         String   @unique
  password      String
  role          String   @default("CUSTOMER") // CUSTOMER | ADMIN | OWNER | SUPER_ADMIN
  fotoProfil    String?
  noKTP         String?
  noSIM         String?
  fotoKTP       String?
  fotoSIM       String?
  alamat        String?
  noTelepon     String?
  verified      Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  rentals       Rental[]
  susResults    SUSResult[]
  ueqResults    UEQResult[]
  notifications Notification[]
}

model Vehicle {
  id            String   @id @default(cuid())
  namaMobil     String
  merk          String
  model         String
  tahun         Int
  warna         String
  platNomor     String
  hargaSewa     Int
  hargaSewa12Jam Int
  kategori      String   // City Car | MPV (Multi Purpose Vehicle) | Van/Minibus
  transmisi     String   // Manual | Automatic
  bahanBakar    String   // Bensin | Diesel | Hybrid | Listrik
  kapasitas     Int
  status        String   @default("TERSEDIA") // TERSEDIA | DISEWA | MAINTENANCE
  foto          String
  deskripsi     String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  rentals       Rental[]
}

model Rental {
  id              String   @id @default(cuid())
  userId          String
  vehicleId       String
  tanggalSewa     DateTime
  tanggalKembali  DateTime
  jamAmbil        String?
  jamKembali      String?
  tanggalPengembalian DateTime?
  status          String   @default("PENDING") // PENDING | ACTIVE | COMPLETED | CANCELLED
  totalHarga      Int
  denda           Int      @default(0)
  durasiType      String   @default("24jam") // 24jam | 12jam
  catatan         String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user            User     @relation(fields: [userId], references: [id])
  vehicle         Vehicle  @relation(fields: [vehicleId], references: [id])
  susResults      SUSResult[]
  ueqResults      UEQResult[]
}

model SUSResult {
  id          String   @id @default(cuid())
  userId      String
  rentalId    String
  q1          Int // Saya merasa akan sering menggunakan aplikasi QiaTrans
  q2          Int // Saya merasa aplikasi QiaTrans terlalu rumit untuk digunakan
  q3          Int // Saya merasa aplikasi QiaTrans mudah digunakan
  q4          Int // Saya membutuhkan bantuan orang lain untuk dapat menggunakan aplikasi QiaTrans
  q5          Int // Saya merasa fitur-fitur pada aplikasi QiaTrans terintegrasi dengan baik
  q6          Int // Saya merasa terdapat banyak ketidakkonsistenan pada aplikasi QiaTrans
  q7          Int // Saya merasa sebagian besar pengguna dapat mempelajari penggunaan aplikasi QiaTrans dengan cepat
  q8          Int // Saya merasa aplikasi QiaTrans membingungkan saat digunakan
  q9          Int // Saya merasa percaya diri ketika menggunakan aplikasi QiaTrans
  q10         Int // Saya merasa perlu mempelajari banyak hal sebelum dapat menggunakan aplikasi QiaTrans
  skor        Float
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id])
  rental      Rental   @relation(fields: [rentalId], references: [id])
}

model UEQResult {
  id              String   @id @default(cuid())
  userId          String
  rentalId        String
  attractiveness  Float
  perspicuity     Float
  efficiency      Float
  dependability   Float
  stimulation     Float
  novelty         Float
  q1              Int // membosankan - menarik
  q2              Int // tidak praktis - praktis
  q3              Int // rumit - mudah
  q4              Int // tidak dapat diprediksi - dapat diprediksi
  q5              Int // kuno - inovatif
  q6              Int // membosankan - mengasyikkan
  q7              Int // tidak menarik - menarik
  q8              Int // sulit dipelajari - mudah dipelajari
  q9              Int // kaku - fleksibel
  q10             Int // ineffisien - effisien
  q11             Int // ketinggalan zaman - terkini
  q12             Int // konvensional - inventif
  q13             Int // mengganggu - mendukung
  q14             Int // biasa - luar biasa
  q15             Int // tidak aman - aman
  q16             Int // memotivasi - tidak memotivasi
  q17             Int // tidak inovatif - kreatif
  q18             Int // lambat - cepat
  q19             Int // tidak jelas - jelas
  q20             Int // menghambat - mendukung
  q21             Int // tradisional - canggih
  q22             Int // konservatif - inovatif
  q23             Int // tidak berguna - berguna
  createdAt       DateTime @default(now())

  user            User     @relation(fields: [userId], references: [id])
  rental          Rental   @relation(fields: [rentalId], references: [id])
}

model Notification {
  id          String   @id @default(cuid())
  userId      String
  title       String
  message     String
  type        String   // INFO | WARNING | SUCCESS | ERROR
  read        Boolean  @default(false)
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id])
}
